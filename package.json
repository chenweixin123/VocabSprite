{
  "name": "vocabsprite",
  "version": "0.1.0",
  "private": true,
  "description": "Offline-first ambient desktop vocabulary learning",
  "license": "AGPL-3.0-or-later",
  "packageManager": "pnpm@10.19.0",
  "scripts": {
    "dev": "pnpm --filter @vocabsprite/desktop dev",
    "tauri:dev": "pnpm --filter @vocabsprite/desktop tauri dev",
    "lint": "eslint . --max-warnings=0",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "typecheck": "pnpm -r --if-present typecheck",
    "test": "vitest run",
    "test:e2e": "playwright test",
    "test:rust": "cargo test --workspace",
    "pack:validate": "tsx packages/pack-schema/src/cli.ts validate packs/catalog.json",
    "assets:validate": "node scripts/validate-assets.mjs",
    "pack:import": "tsx packages/pack-schema/src/cli.ts import",
    "pack:diff": "tsx packages/pack-schema/src/cli.ts diff",
    "build": "pnpm -r --if-present build",
    "tauri:build": "pnpm --filter @vocabsprite/desktop tauri build",
    "screenshots": "playwright test --project=screenshots",
    "benchmark": "tsx scripts/benchmark.ts"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.1",
    "@playwright/test": "^1.56.1",
    "@testing-library/jest-dom": "7.0.1",
    "@testing-library/react": "^16.3.0",
    "@testing-library/user-event": "^14.6.1",
    "@types/node": "^24.10.0",
    "@types/react": "^19.2.2",
    "@types/react-dom": "^19.2.2",
    "@vitejs/plugin-react": "^5.1.1",
    "eslint": "^9.39.1",
    "eslint-plugin-react-hooks": "^7.0.1",
    "eslint-plugin-react-refresh": "^0.4.24",
    "globals": "^16.5.0",
    "jsdom": "^27.2.0",
    "playwright": "^1.56.1",
    "prettier": "^3.6.2",
    "tsx": "^4.20.6",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.46.4",
    "vite": "^7.2.2",
    "vitest": "^4.0.9"
  }
}
